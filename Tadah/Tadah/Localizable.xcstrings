    },
    "Turned down before? Ask about a 'second-chance' account and check your ChexSystems report for errors.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Te rechazaron antes? Pregunta por una cuenta de “segunda oportunidad” y revisa tu informe de ChexSystems por si hay errores."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "曾被拒绝？询问是否有“第二次机会”账户，并检查你的 ChexSystems 报告有无错误。"
          }
        }
      }
    },
    "Two proofs of residency: lease, utility bill, bank statement, or government mail.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
