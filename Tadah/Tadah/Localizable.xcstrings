          }
        }
      }
    },
    "Exchange your out-of-state license for a %@ license — check your state DMV for the deadline, as license and car-registration deadlines can be different." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
