    "Have your household size and income ready — that decides your options and any savings." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ten a mano el tamaño de tu hogar y tus ingresos: eso determina tus opciones y los ahorros."
