            "value" : "缴纳申请费并提交。"
          }
        }
      }
    },
    "Pay the security deposit and first month's rent, and keep the receipts." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paga el depósito de garantía y el primer mes de renta, y guarda los recibos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支付押金和第一个月房租，并保留收据。"
          }
        }
      }
    },
    "Pay your deductible if any, then pick up and check the car." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Paga tu deducible si lo hay, luego recoge y revisa el coche."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "支付自付额（如有），然后取车并检查。"
          }
