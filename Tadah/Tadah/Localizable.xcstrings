          }
        }
      }
    },
    "You're signed in, but we couldn't finish backing up yet. It will retry on its own." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has iniciado sesión, pero aún no pudimos completar la copia de seguridad. Se reintentará solo."
