          }
        }
      }
    },
    "Benefits enrollment is usually a one-time window (~30 days) when you start. Miss it and you may have to wait until the next year.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La inscripción a beneficios suele ser una ventana única (~30 días) al empezar. Si la pierdes, puede que esperes hasta el próximo año."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "福利参保通常是入职时的一次性窗口（约 30 天）。错过了可能要等到明年。"
          }
        }
      }
    },
    "Benefits enrollment usually closes ~30 days after you start — add a reminder.": {
      "extractionState": "stale",
