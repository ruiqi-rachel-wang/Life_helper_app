          "stringUnit" : {
            "state" : "translated",
            "value" : "你的孩子是否接受特殊教育服务（IEP/504）？"
          }
        }
      }
    },
    "Doesn't repeat" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No se repite"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不重复"
          }
        }
      }
    },
    "Don't argue about fault at the scene — collect the facts and let the police and insurers sort it out." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No discutas de quién tuvo la culpa en el lugar: reúne los hechos y deja que la policía y las aseguradoras lo resuelvan."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "不要在现场争论谁的责任。收集事实，交给警方和保险公司判定。"
          }
        }
      }
    },
    "Don't authorize repairs before the claim is approved, unless you're paying yourself." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No autorices reparaciones antes de que aprueben el reclamo, a menos que pagues tú."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "理赔批准前不要授权维修，除非你打算自己付钱。"
          }
        }
      }
    },
    "Don't miss a deadline" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No pierdas ninguna fecha límite"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "别错过任何截止日期"
          }
        }
      }
    },
    "Don't open new credit cards or change jobs while your mortgage is in underwriting — it can delay or sink the loan." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No abras tarjetas de crédito nuevas ni cambies de trabajo mientras se evalúa tu hipoteca: puede retrasar o hundir el préstamo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
