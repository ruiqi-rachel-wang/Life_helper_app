          }
        }
      }
    },
    "It won't agree to a charge" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No aceptará ningún cargo"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它不会答应任何费用"
          }
        }
      }
    },
    "It won't give out your details" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No dará tus datos"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它不会透露你的私人信息"
          }
        }
      }
    },
    "It works right away, with no account. Create a free account whenever you like to use Plus on your other devices and add family members — you'll find it on the Profile tab." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funciona de inmediato, sin cuenta. Crea una cuenta gratis cuando quieras para usar Plus en tus otros dispositivos y agregar familiares; la encontrarás en la pestaña Perfil."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无需账户，立即可用。随时创建免费账户，即可在你的其他设备上使用 Plus 并添加家庭成员——在“我的”标签页即可找到。"
          }
        }
      }
    },
    "Item" : {
      "extractionState" : "manual",
