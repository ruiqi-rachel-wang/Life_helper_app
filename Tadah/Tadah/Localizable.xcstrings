    },
    "A payment plan or instalment arrangement" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un plan de pago o acuerdo de cuotas"
          }
        },
        "zh-Hans" : {
