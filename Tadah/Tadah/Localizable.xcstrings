          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "要雇人？登记所需的工资税，查询你所在州的工伤保险要求，设置工资发放，并为每位员工填写 I-9 表。"
          }
