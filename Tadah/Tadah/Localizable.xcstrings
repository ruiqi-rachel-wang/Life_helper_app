    "Photos of all vehicles, the damage, and the wider scene.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fotos de todos los vehículos, los daños y el lugar en general."
