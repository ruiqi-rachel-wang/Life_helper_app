    "Gross pay is before deductions; net (take-home) pay is after. Check your first stub closely — pay mistakes are easiest to fix early.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago bruto es antes de las deducciones; el pago neto (lo que recibes) es después. Revisa bien tu primer recibo: los errores de pago son más fáciles de corregir al principio."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "税前工资（gross）是扣款之前的金额；到手工资（net）是扣款之后的金额。仔细核对你的第一张工资条——发薪错误越早发现越容易更正。"
          }
        }
      }
    },
