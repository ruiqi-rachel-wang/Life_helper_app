        }
      }
    },
    "Call or use the patient portal to book — new-patient slots can take weeks." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llama o usa el portal del paciente para reservar: los cupos para pacientes nuevos pueden tardar semanas."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "打电话或用患者门户预约，新患者的号可能要等几周。"
          }
        }
      }
    },
    "Call or use the patient portal to book your visit." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llama o usa el portal del paciente para reservar tu cita."
          }
        },
