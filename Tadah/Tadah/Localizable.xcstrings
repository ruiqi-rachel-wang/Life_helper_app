            "value": "请回答上面的问题以继续"
          }
        }
      }
    },
    "Any benefit or retirement deductions you signed up for.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cualquier deducción de beneficios o de jubilación que hayas elegido."
          }
        },
