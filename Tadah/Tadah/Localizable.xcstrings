          "stringUnit" : {
            "state" : "translated",
            "value" : "本月第 %1$lld 次通话，共 %2$lld 次。"
          }
        }
      }
    },
    "Call and ask if they're taking new patients." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
