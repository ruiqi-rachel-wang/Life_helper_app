    },
    "See a doctor or urgent care within a day or two, even if you feel okay.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ve a un médico o a atención de urgencia en uno o dos días, aunque te sientas bien."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使感觉没事，也要在一两天内看医生或去急护中心（urgent care）。"
          }
        }
      }
    },
    "Select items to add": {
      "localizations": {
        "es": {
          "stringUnit": {
