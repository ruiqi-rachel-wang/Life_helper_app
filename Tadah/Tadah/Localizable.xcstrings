        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已登录，但备份尚未完成。系统会自动重试。"
          }
        }
      }
    },
    "You've been signed out everywhere. Sign in with your new password." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se cerró tu sesión en todos los dispositivos. Inicia sesión con tu nueva contraseña."
