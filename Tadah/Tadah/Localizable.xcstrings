    "Covers common USCIS filings only — it doesn't cover every visa type or situation." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cubre solo trámites comunes de USCIS: no abarca todos los tipos de visa ni situaciones."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
