          }
        }
      }
    },
    "You can close this — the answer will be saved to this to-do." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puedes cerrar esto: la respuesta se guardará en esta tarea."
