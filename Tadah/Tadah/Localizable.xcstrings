          }
        }
      }
    },
    "Even if your income is low, lawfully present immigrants who don't yet qualify for Medicaid can often still get Marketplace savings.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aunque tus ingresos sean bajos, los inmigrantes con presencia legal que aún no califican para Medicaid a menudo pueden obtener ahorros del Marketplace."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即使收入较低，尚不符合 Medicaid 资格的合法身份移民，通常仍可获得市场补贴。"
          }
        }
      }
    },
