    },
    "Public schools generally can't deny enrollment based on immigration status. If asked for an SSN, ask whether it's optional or if another ID can be used.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las escuelas públicas no pueden negar la inscripción por el estatus migratorio. Si te piden un SSN, pregunta si es opcional o si puedes usar otra identificación."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公立学校通常不能因移民身份拒绝入学。若被要求提供 SSN，可询问是否为可选项，或能否用其他证件代替。"
          }
        }
      }
    },
    "Public schools must offer English-language help and can't turn your child away.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las escuelas públicas deben ofrecer ayuda con el inglés y no pueden rechazar a tu hijo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公立学校必须提供英语帮助，不能拒收你的孩子。"
          }
        }
      }
    },
    "Qualifying changes include losing other coverage, moving, marriage, a new baby or adoption, or certain income or household changes.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios que califican incluyen perder otra cobertura, mudarte, casarte, tener o adoptar un bebé, o ciertos cambios de ingresos u hogar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "符合条件的变化包括：失去其他保险、搬家、结婚、新生或收养孩子，或某些收入或家庭情况的变化。"
          }
        }
      }
    },
    "Quiet delivery.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Entrega silenciosa."
          }
        },
        "zh-Hans": {
