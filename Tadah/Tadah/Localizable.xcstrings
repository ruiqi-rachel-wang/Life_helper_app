          }
        }
      }
    },
    "You may need to prove it — a coverage-loss letter, marriage or birth certificate, or a lease." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Es posible que debas comprobarlo: una carta de pérdida de cobertura, un certificado de matrimonio o nacimiento, o un contrato de arrendamiento."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你可能需要提供证明：失去保险的信函、结婚证或出生证明，或租约。"
          }
        }
      }
    },
    "You signed in on another device. A free account can be used on one device at a time — Tadah Plus lets you use more. Your tasks are still saved here." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Iniciaste sesión en otro dispositivo. Una cuenta gratuita se usa en un dispositivo a la vez; Tadah Plus te permite usar más. Tus tareas siguen guardadas aquí."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你在另一台设备上登录了。免费账户一次只能在一台设备上使用。升级 Tadah Plus 可同时使用多台设备。你的待办事项仍保存在此设备上。"
          }
        }
      }
    },
    "You're on Tadah Plus" : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ya tienes Tadah Plus"
