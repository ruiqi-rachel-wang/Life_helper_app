    "OpenAI does not use it to train their AI, and may keep it up to about 30 days to check for misuse. We keep no copy on our server." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI no lo usa para entrenar su IA, y puede conservarlo hasta unos 30 días para detectar usos indebidos. Nosotros no guardamos ninguna copia en nuestro servidor."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OpenAI 不会用它训练 AI，可能会保留最多约 30 天以排查滥用。我们的服务器不保留任何副本。"
          }
        }
      }
