            "value": "添加详情"
          }
        }
      }
    },
    "Add a due date": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir fecha de vencimiento"
          }
        },
