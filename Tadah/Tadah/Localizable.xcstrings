        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "至少 8 个字符"
          }
        }
      }
    },
    "At the scene now" : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ahora en el lugar"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "现在在现场"
          }
        }
      }
    },
    "At the scene, police report, insurance claim" : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "En el lugar, informe policial, reclamo de seguro"
          }
        },
        "zh-Hans" : {
