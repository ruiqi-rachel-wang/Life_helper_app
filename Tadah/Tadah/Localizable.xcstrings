    "": {},
    "… PLUS List C (work): Social Security card or birth certificate.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "… MÁS Lista C (trabajo): tarjeta de Seguro Social o certificado de nacimiento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "… 加 列表 C（工作）：社会安全卡或出生证明。"
          }
        }
      }
    },
    "%@ before": {
