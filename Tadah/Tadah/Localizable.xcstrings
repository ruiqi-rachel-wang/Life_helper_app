    "Check everyone for injuries before moving on.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa si alguien está herido antes de continuar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先检查每个人是否受伤，再做其他事。"
          }
        }
      }
    },
    "Check my case status": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultar el estado de mi caso"
          }
        },
