    "Bring originals — most documents can't be photocopies.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva los originales: la mayoría de los documentos no pueden ser fotocopias."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "携带原件——大多数证件不能用复印件。"
          }
        }
      }
    },
    "Bring your child's IEP/504 records and ask how their services will continue at the new school.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva los registros IEP/504 de tu hijo y pregunta cómo continuarán esos servicios en la nueva escuela."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "带上孩子的 IEP/504 记录，并询问这些服务将如何在新学校延续。"
          }
        }
      }
    },
    "Bring your insurance card and a photo ID, and arrive early for new-patient forms.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lleva tu tarjeta del seguro y una identificación con foto, y llega temprano para los formularios de paciente nuevo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "带上你的保险卡和带照片的身份证件，并提前到达填写新患者表格。"
          }
        }
      }
    },
    "Budget the full monthly cost: loan payment, property taxes, insurance, and any HOA fee.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Presupuesta el costo mensual completo: pago del préstamo, impuestos de la propiedad, seguro y cualquier cuota de HOA."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按每月总成本做预算：贷款月供、房产税、保险，以及业主协会（HOA）费用。"
          }
        }
      }
    },
    "Build my checklist": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crear mi lista"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成我的清单"
          }
        }
      }
    },
