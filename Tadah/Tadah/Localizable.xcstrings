    "Tour the unit and read the lease before signing — note the rent, lease length, deposit, who pays which utilities, and any pet or early-termination fees." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visita la vivienda y lee el contrato antes de firmar: fíjate en la renta, la duración, el depósito, quién paga cada servicio y las tarifas por mascotas o por terminar antes."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "签约前先看房并通读租约：留意租金、租期、押金、各项水电费由谁承担，以及宠物费和提前退租的费用。"
          }
        }
      }
    },
    "Tow to a repair shop or your home — not a storage lot." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remolca a un taller o a tu casa, no a un depósito."
