    "Add %lld to inbox": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir %lld a la bandeja"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 %lld 项到待办"
          }
        }
      }
    },
    "Add a date": {
      "localizations": {
        "es": {
          "stringUnit": {
