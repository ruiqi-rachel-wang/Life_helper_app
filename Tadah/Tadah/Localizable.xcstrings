          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标记完成"
          }
        }
      }
    },
    "Marketplace plans often come with savings (subsidies) based on your income.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los planes del Marketplace suelen incluir ahorros (subsidios) según tus ingresos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "市场计划通常会根据你的收入提供补贴（优惠）。"
          }
        }
      }
    },
    "Marketplace, Medicaid, or a job plan": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marketplace, Medicaid o un plan del trabajo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保险市场、Medicaid 或单位保险"
          }
        }
      }
    },
    "Medicaid and CHIP are free or low-cost coverage for lower incomes (CHIP covers kids).": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Medicaid y CHIP son cobertura gratuita o de bajo costo para ingresos bajos (CHIP cubre a los niños)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Medicaid 和 CHIP 是为低收入者提供的免费或低价保障（CHIP 覆盖儿童）。"
          }
        }
      }
    },
