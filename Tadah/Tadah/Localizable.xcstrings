          }
        }
      }
    },
    "Choose a repair shop — you can usually pick your own.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige un taller: normalmente puedes escoger el tuyo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择修理厂——通常你可以自己选。"
          }
        }
      }
    },
    "Choose your structure — sole proprietor (simplest) or LLC (separates your personal assets) — then register accordingly.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
