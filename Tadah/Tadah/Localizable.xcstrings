    },
    "Check %@ DMV requirements and book an appointment online." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta los requisitos del DMV de %@ y reserva una cita en línea."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查看 %@ 车管局（DMV）的要求，并在线预约。"
          }
        }
      }
    },
    "Check every light, the horn, the wipers, the mirrors, and the tires the day before." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa todas las luces, el claxon, los limpiaparabrisas, los espejos y las llantas el día anterior."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "前一天把所有车灯、喇叭、雨刮、后视镜和轮胎都检查一遍。"
          }
        }
      }
    },
    "Check everyone for injuries before moving on." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Revisa si alguien está herido antes de continuar."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先检查每个人是否受伤，再做其他事。"
          }
        }
      }
    },
    "Check first-time buyer programs in your state — many offer down-payment help or a lower rate, and you apply before making an offer." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta los programas para compradores de primera vivienda de tu estado: muchos ofrecen ayuda con el pago inicial o una tasa más baja, y se solicitan antes de hacer una oferta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查询你所在州的首次购房项目。很多提供首付补助或更低利率，且需在出价前申请。"
          }
        }
      }
    },
    "Check first-time buyer programs in your state — many offer down-payment help or a lower rate. Ask early how each one works and when to apply, since some need to be lined up before you make an offer." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta los programas para compradores primerizos en tu estado: muchos ofrecen ayuda con el enganche o una tasa más baja. Pregunta pronto cómo funciona cada uno y cuándo solicitarlo, ya que algunos deben quedar listos antes de hacer una oferta."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "了解你所在州面向首次购房者的项目，很多提供首付补助或更低利率。尽早询问每个项目的运作方式和申请时机，因为有些需要在你出价之前就安排妥当。"
          }
        }
      }
    },
