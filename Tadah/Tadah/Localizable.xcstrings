        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recoge las llaves, la llave del buzón y el acceso al edificio, y entérate de las normas de basura, estacionamiento y lavandería."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拿到房门钥匙、信箱钥匙和楼宇门禁，并了解垃圾投放、停车和洗衣的规定。"
          }
        }
      }
    },
    "Give your landlord written notice (check your lease — often 30–60 days)." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avisa a tu arrendador por escrito (revisa tu contrato: suele ser con 30–60 días de anticipación)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "书面通知房东（查看租约，通常需提前 30–60 天）。"
          }
        }
      }
    },
    "Go along and follow the inspector around; the walkthrough teaches you more than the report." : {
      "extractionState" : "manual",
