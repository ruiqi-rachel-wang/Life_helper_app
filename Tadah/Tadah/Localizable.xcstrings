          }
        }
      }
    },
    "You've used all %lld scans and guides for the last 30 days. They free up as your earlier ones pass the 30-day mark." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Has usado los %lld escaneos y guías de los últimos 30 días. Se liberan a medida que los anteriores superan los 30 días."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你已用完过去 30 天的全部 %lld 次扫描和指南。随着较早的记录超过 30 天，额度会逐步恢复。"
