    },
    "More scans and a bigger to-do list, no account needed. Add a free account any time to use Plus on your other devices and add family members." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Más escaneos y una lista de tareas más grande, sin necesidad de cuenta. Añade una cuenta gratis cuando quieras para usar Plus en tus otros dispositivos y agregar familiares."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "更多扫描次数和更大的待办清单，无需账户。随时添加免费账户，即可在你的其他设备上使用 Plus 并添加家庭成员。"
          }
        }
      }
    },
    "More than one device" : {
