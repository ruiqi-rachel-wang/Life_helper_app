        }
      }
    },
    "⚠︎ couldn't read clearly — review before adding": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠︎ no se leyó con claridad — revisa antes de añadir"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠︎ 识别不清 — 添加前请核对"
          }
        }
      }
    },
    "⚠ DUE TODAY": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ VENCE HOY"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ 今日到期"
          }
        }
      }
    },
    "✓ COMPLETED": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "✓ COMPLETADO"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "✓ 已完成"
          }
        }
      }
    },
    "👋 Welcome to Tadah": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "👋 Bienvenido a Tadah"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "👋 欢迎使用 Tadah"
          }
        }
      }
    },
    "$": {},
    "0.00": {},
    "1099 forms for contract or gig income.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Formularios 1099 por ingresos de contrato o trabajos esporádicos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用于合同或零工收入的 1099 表。"
          }
        }
      }
    },
    "A buyer's agent represents you, not the seller. You may be asked to sign a buyer agreement — read what it says about services and fees before signing.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un agente del comprador te representa a ti, no al vendedor. Puede que te pidan firmar un acuerdo de comprador: lee qué dice sobre servicios y honorarios antes de firmar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "买方经纪人代表你，而不是卖家。你可能被要求签买方协议——签字前读清楚服务内容和费用条款。"
          }
        }
      }
    },
    "A few quick questions so Tadah can tailor the checklist.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unas preguntas rápidas para que Tadah ajuste la lista."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回答几个小问题，Tadah 就能为你定制清单。"
          }
        }
      }
    },
    "A first plan can be one page — you can refine it later.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un primer plan puede ser de una página; puedes pulirlo después."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第一版计划一页纸就行——以后可以再完善。"
          }
        }
      }
    },
    "A free USCIS online account lets you file, pay, upload documents, and track your case.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cuenta en línea gratuita de USCIS te permite presentar, pagar, subir documentos y seguir tu caso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "免费的 USCIS 在线账户可用于提交、缴费、上传文件和跟踪案件。"
          }
        }
      }
    },
    "A health permit if you handle food.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un permiso sanitario si manejas alimentos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你经营食品，需要卫生许可。"
          }
        }
      }
    },
    "A job (W-2)": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un empleo (W-2)"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有工作（W-2）"
          }
        }
      }
    },
    "A list of doctors you want to keep and prescriptions you take, to check they're covered.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una lista de los médicos que quieres conservar y los medicamentos que tomas, para verificar que estén cubiertos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一份你想继续看的医生和常吃的处方药清单，用来核对是否在保障范围内。"
          }
        }
      }
    },
    "A list of your medicines, doses, and allergies.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una lista de tus medicamentos, dosis y alergias."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的用药、剂量和过敏清单。"
          }
        }
      }
    },
    "A little prep makes the visit go smoothly.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un poco de preparación hace que la cita vaya bien."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "做一点准备能让就诊更顺利。"
          }
        }
      }
    },
    "A photo or screenshot you already have": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una foto o captura que ya tienes"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机里已有的照片或截图"
          }
        }
      }
    },
    "A recent change — lost coverage, moved, married, had a baby, or job change?": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Un cambio reciente: perdiste cobertura, te mudaste, te casaste, tuviste un bebé o cambiaste de trabajo?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近有变化吗——失去保险、搬家、结婚、生孩子或换工作？"
          }
        }
      }
    },
    "A recent life change may open a Special Enrollment Period — you can sign up now, outside open enrollment.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un cambio de vida reciente puede abrir un Período Especial de Inscripción: puedes inscribirte ahora, fuera de la inscripción abierta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "近期的人生变化可能开启“特殊参保期”——你现在就能参保，无需等公开参保期。"
          }
        }
      }
    },
    "A referral, if your plan needs one for a specialist.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una remisión, si tu plan la exige para un especialista."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你的保险看专科需要转诊，带上转诊单。"
          }
        }
      }
    },
    "A refund means money back; owing means you pay — filing on time avoids penalties either way.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un reembolso significa que te devuelven dinero; deber significa que pagas: en ambos casos, declarar a tiempo evita multas."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "退税意味着拿回钱；欠税意味着要补缴——无论哪种，按时报税都能避免罚款。"
          }
        }
      }
    },
    "A second ID if the bank asks for two.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una segunda identificación si el banco pide dos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果银行要求两份证件，再准备第二份。"
          }
        }
      }
    },
    "A security deposit is usually about one month's rent; you should get it back (minus any damage) after you move out.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El depósito suele ser un mes de alquiler; deberías recuperarlo (menos cualquier daño) al mudarte."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "押金通常约为一个月房租；搬走后应退还给你（扣除任何损坏）。"
          }
        }
      }
    },
    "A separate business account keeps your bookkeeping clean and protects an LLC's liability shield. Bring your EIN and formation documents.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una cuenta de empresa separada mantiene limpia la contabilidad y protege el escudo de responsabilidad de la LLC. Lleva tu EIN y los documentos de constitución."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单独的公司账户能让记账清晰，并维护 LLC 的责任隔离。带上你的 EIN 和成立文件。"
          }
        }
      }
    },
    "A sole proprietorship is simplest but doesn't separate your personal assets. An LLC costs a state fee but protects your personal assets if the business is sued or owes money.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ser empresario individual es lo más simple pero no separa tus bienes personales. Una LLC cuesta una tarifa estatal pero protege tus bienes si demandan al negocio o este debe dinero."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "个体经营最简单，但不隔离个人资产。LLC 需缴一笔州费用，但当公司被起诉或欠债时能保护你的个人资产。"
          }
        }
      }
    },
    "A Special Enrollment Period usually gives you 60 days from the life event to enroll — after that you generally wait for open enrollment, so start now.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un Período Especial de Inscripción suele darte 60 días desde el evento para inscribirte; después, por lo general debes esperar a la inscripción abierta, así que empieza ya."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "特殊参保期通常给你从事件发生起 60 天来参保——过了这段时间一般就要等公开参保期，所以尽快开始。"
          }
        }
      }
    },
    "A step-by-step checklist for buying a home, from pre-approval to closing.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una lista paso a paso para comprar una vivienda, desde la preaprobación hasta el cierre."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "买房的分步清单，从预批到过户。"
          }
        }
      }
    },
    "A step-by-step checklist for changing your address and moving.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una lista paso a paso para cambiar tu dirección y mudarte."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "更改地址和搬家的分步清单。"
          }
        }
      }
    },
    "A step-by-step checklist for renting and moving into a new place.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una lista paso a paso para alquilar y mudarte a un nuevo lugar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "租房并搬入新住处的分步清单。"
          }
        }
      }
    },
    "A step-by-step checklist to get from credit check to an accepted offer.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una lista paso a paso desde revisar tu crédito hasta que acepten tu oferta."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一份从信用检查到报价被接受的分步清单。"
          }
        }
      }
    },
    "A step-by-step checklist to start a business — structure, EIN, licenses, and taxes.": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una lista paso a paso para iniciar un negocio: estructura, EIN, licencias e impuestos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创业的分步清单——架构、EIN、执照和税务。"
          }
        }
      }
    },
    "A task needs your attention — open Tadah.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una tarea necesita tu atención — abre Tadah."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有事项需要处理——打开 Tadah 查看。"
          }
        }
      }
    },
    "ABOUT & LEGAL": {
      "localizations": {
