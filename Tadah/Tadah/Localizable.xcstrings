    "No proof of address? Ask what alternatives the bank accepts (an employer, school, or shelter letter often works)." : {
      "extractionState" : "stale",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "¿Sin comprobante de domicilio? Pregunta qué alternativas acepta el banco (una carta del empleador, la escuela o un refugio suele servir)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有地址证明？询问银行接受哪些替代材料（雇主、学校或收容所的信函通常可以）。"
          }
        }
      }
    },
    "No reminders — add one above." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sin recordatorios — añade uno arriba."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "没有提醒 — 在上方添加一个。"
          }
        }
      }
    },
    "No reminders." : {
      "localizations" : {
