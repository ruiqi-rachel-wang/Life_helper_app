    "Unpaid roles have no tax forms — there's no W-2 or 1099 to expect." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los puestos no remunerados no tienen formularios de impuestos: no esperes un W-2 ni un 1099."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无薪职位没有税表，不会有 W-2 或 1099。"
          }
        }
      }
    },
    "Unpaid roles have no tax forms — there's no W-2 or 1099 to expect. Unpaid internships also have specific legal rules: if you're doing the same work as paid staff, ask about pay." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los puestos sin remuneración no tienen formularios fiscales: no habrá W-2 ni 1099. Las prácticas no remuneradas tienen reglas legales específicas: si haces el mismo trabajo que el personal pagado, pregunta por el sueldo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "无薪岗位没有税务表格，不会有 W-2 或 1099。无薪实习另有特定法律规定：若你与带薪员工做同样的工作，应询问薪酬。"
          }
        }
      }
    },
