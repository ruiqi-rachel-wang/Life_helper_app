    "Translation failed. Check your connection and try again.": {
      "extractionState": "manual",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La traducción falló. Revisa tu conexión e inténtalo de nuevo."
          }
        },
