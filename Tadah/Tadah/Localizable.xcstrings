          }
        }
      }
    },
    "Covers the 50 states and DC. In a U.S. territory, registration and licensing run through different offices — check your territory's business agency." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cubre los 50 estados y DC. En un territorio de EE. UU., el registro y las licencias se tramitan en otras oficinas: consulta la agencia empresarial de tu territorio."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "适用于 50 个州和华盛顿特区。在美国海外领地，注册和执照由不同机构办理，请咨询你所在领地的工商主管部门。"
          }
        }
      }
    },
    "Covers the 50 states and DC. In Puerto Rico, the U.S. Virgin Islands, Guam, the CNMI, or American Samoa, check your territory's own motor-vehicle office — the rules and forms differ." : {
      "extractionState" : "manual",
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cubre los 50 estados y DC. En Puerto Rico, las Islas Vírgenes de EE. UU., Guam, las Islas Marianas del Norte o Samoa Americana, consulta la oficina de vehículos de motor de tu territorio: las reglas y los formularios cambian."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "适用于 50 个州和华盛顿特区。在波多黎各、美属维尔京群岛、关岛、北马里亚纳群岛或美属萨摩亚，请咨询当地的车辆管理机构，规则和表格并不相同。"
          }
        }
      }
    },
    "Create a free account" : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Crear una cuenta gratis"
          }
        },
