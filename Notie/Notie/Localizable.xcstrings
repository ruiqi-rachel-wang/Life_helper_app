{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    "%lld pages": {
      "comment": "Multi-page scan badge",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld páginas"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 页"
          }
        }
      }
    },
    "👋 Welcome to Plaino": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "👋 Bienvenido a Plaino"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "👋 欢迎使用 Plaino"
          }
        }
      }
    },
    "Plaino turns a confusing bill or letter into simple steps like these.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Plaino convierte una factura o carta confusa en pasos simples como estos."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Plaino 把看不懂的账单或信件变成像这样的简单步骤。"
          }
        }
      }
    },
    "Tap ＋ Add to scan a document — Plaino explains it and what to do.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca ＋ Añadir para escanear un documento: Plaino lo explica y te dice qué hacer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按 ＋ 添加 来扫描文件 — Plaino 会解释它是什么以及该怎么做。"
          }
        }
      }
    },
    "Tap a circle to check off a step as you finish it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca un círculo para marcar un paso cuando lo termines."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成一步后，点按圆圈打勾。"
          }
        }
      }
    },
    "Example: an electric bill": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejemplo: una factura de luz"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "示例：电费账单"
          }
        }
      }
    },
    "Scanned bills show the amount and due date up top.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las facturas escaneadas muestran el importe y la fecha de vencimiento arriba."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描的账单会在顶部显示金额和截止日期。"
          }
        }
      }
    },
    "Plaino reminds you before it's due so you don't forget.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Plaino te avisa antes del vencimiento para que no lo olvides."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Plaino 会在到期前提醒你，免得忘记。"
          }
        }
      }
    },
    "When you've paid, tap Mark done.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando pagues, toca Marcar hecho."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "付款后，点按“标记完成”。"
          }
        }
      }
    },
    "Example: a finished task": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ejemplo: una tarea terminada"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "示例：已完成的任务"
          }
        }
      }
    },
    "Finished tasks move down here to Done.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las tareas terminadas se mueven aquí, a Hecho."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成的任务会移到下面的“完成”区。"
          }
        }
      }
    },
    "Open one to reopen it or delete it.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre una para reabrirla o eliminarla."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开任意一个可以重新打开或删除。"
          }
        }
      }
    },
    "%@ before": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 前"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ antes"
          }
        }
      }
    },
    "%lld": {},
    "%lld active": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld activas"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 项待办"
          }
        }
      }
    },
    "%lld days overdue": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld day overdue"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld days overdue"
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld día de retraso"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld días de retraso"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "逾期 %lld 天"
          }
        }
      }
    },
    "%lld of %lld": {
      "comment": "steps done of total",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld de %2$lld"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld / %2$lld"
          }
        }
      }
    },
    "%lld THINGS FOUND": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ELEMENTOS"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找到 %lld 项"
          }
        }
      }
    },
    "•": {},
    "⚠ %lld DAYS OVERDUE": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "⚠ %lld DAY OVERDUE"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "⚠ %lld DAYS OVERDUE"
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "⚠ %lld DÍA DE RETRASO"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "⚠ %lld DÍAS DE RETRASO"
                }
              }
            }
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠ 逾期 %lld 天"
          }
        }
      }
    },
    "⚠︎ couldn't read clearly — review before adding": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠︎ no se leyó con claridad — revisa antes de añadir"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "⚠︎ 识别不清 — 添加前请核对"
          }
        }
      }
    },
    "✓ COMPLETED": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "✓ COMPLETADO"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "✓ 已完成"
          }
        }
      }
    },
    "$": {},
    "0.00": {},
    "A few quick questions so Plaino can tailor the checklist.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unas preguntas rápidas para que Plaino ajuste la lista."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回答几个小问题，Plaino 就能为你定制清单。"
          }
        }
      }
    },
    "ACCOUNT": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "CUENTA"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "账户"
          }
        }
      }
    },
    "ACTION": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "TAREA"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "事项"
          }
        }
      }
    },
    "ACTION STEPS": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "PASOS A SEGUIR"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作步骤"
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加"
          }
        }
      }
    },
    "Add %lld to inbox": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir %lld a la bandeja"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加 %lld 项到收件箱"
          }
        }
      }
    },
    "Add a detail": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir un detalle"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加详情"
          }
        }
      }
    },
    "Add a due date": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir fecha de vencimiento"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加截止日期"
          }
        }
      }
    },
    "Add a link": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir un enlace"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加链接"
          }
        }
      }
    },
    "Add a note": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir una nota"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加备注"
          }
        }
      }
    },
    "Add a note…": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir una nota…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加备注…"
          }
        }
      }
    },
    "Add a photo": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir una foto"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加照片"
          }
