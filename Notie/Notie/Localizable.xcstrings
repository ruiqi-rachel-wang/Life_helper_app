            "state": "translated",
            "value": "Comprobando…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检查中…"
          }
        }
      }
    },
    "CHECKLIST": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "LISTA"
          }
        },
        "zh-Hans": {
