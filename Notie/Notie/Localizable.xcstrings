    "Only %lld of %lld photos could be opened — continuing with those.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只能打开 %1$lld / %2$lld 张照片，将使用已成功打开的照片。"
          }
        },
