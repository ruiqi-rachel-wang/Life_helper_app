      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir un paso"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加步骤"
          }
        }
      }
    },
    "Add a step (or leave empty for a reminder)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加步骤（留空则仅作提醒）"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade un paso (o déjalo vacío para un recordatorio)"
          }
        }
      }
    },
    "Add date": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir fecha"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加日期"
          }
        }
      }
    },
    "Add to inbox": {
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añadir a la bandeja"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加到收件箱"
          }
        }
      }
    },
    "OK": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好的"
          }
        }
      }
    },
    "Scan limit reached": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Límite de escaneos alcanzado"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已达扫描上限"
          }
        }
      }
    },
    "You've reached today's scan limit (%lld a day). Try again tomorrow.": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has alcanzado el límite de escaneos de hoy (%lld al día). Inténtalo mañana."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已达到今天的扫描上限（每天 %lld 次）。请明天再试。"
          }
        }
      }
    },
    "You've reached this month's scan limit (%lld a month).": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has alcanzado el límite de escaneos de este mes (%lld al mes)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已达到本月的扫描上限（每月 %lld 次）。"
          }
        }
      }
    },
    "All": {
      "comment": "Guides category filter: show all",
      "extractionState": "stale",
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todas"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部"
          }
        }
      }
    },
    "Answer the questions above to continue": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responde las preguntas para continuar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请回答上面的问题以继续"
          }
        }
      }
    },
    "Auto": {
      "localizations": {
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Auto"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
