    "Let's take a quick tour — add your first to-do and see how Cuevi keeps you on track." : {
      "localizations" : {
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Un recorrido rápido: añade tu primer pendiente y mira cómo Cuevi te mantiene al día."
          }
        },
        "zh-Hans" : {
