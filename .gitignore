# macOS
.DS_Store

# Xcode
build/
DerivedData/
DerivedData*/
*.pbxuser
!default.pbxuser
*.mode1v3
!default.mode1v3
*.mode2v3
!default.mode2v3
*.perspectivev3
!default.perspectivev3
xcuserdata/
*.xccheckout
*.moved-aside
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
*.xcuserstate

# Swift Package Manager
.swiftpm/
.build/
Packages/

# Secrets — NEVER commit these
.env
*.env
# Wrangler's LOCAL secret file (`wrangler dev` reads it). Deployed secrets live in
# `wrangler secret put` and never touch the repo, but this one is a real file on
# disk holding real keys — and `.env` above does not match it.
.dev.vars
.dev.vars.*
secrets.plist
# (APIKeys.swift no longer holds a secret — it reads OPENAI_API_KEY from the
#  environment at runtime, so it is committed and a clean checkout compiles.)
*.key
*.pub
*.pem
*.p12
*.mobileprovision

# Personal test documents (PII) — never commit
testing files/

# Apple keys — never commit these (In-App Purchase / App Store Connect API .p8)
*.p8
AuthKey_*
SubscriptionKey_*

# Wrangler's local cache. Holds the Cloudflare account id and personal email —
# not a credential, but not something to publish either. Untracked 2026-08-08.
.wrangler/
